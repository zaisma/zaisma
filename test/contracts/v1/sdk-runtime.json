  "OWN_SERVER_URL": {
    "kind": "constant",
    "value": "/^(wss|https):\\/\\/[^/]/"
  },
  "LINK_NAME": {
    "kind": "constant",
    "value": "/^[a-z][a-z0-9_]{0,31}$/"
  },
  "LINK_PATH": {
    "kind": "constant",
    "value": "/^(\\/[^/?#\\\\]+)+\\/?$/"
  },
  "SAVE_COPY_ID": {
    "kind": "constant",
    "value": "/^save_copy_[a-z0-9-]{1,40}$/"
