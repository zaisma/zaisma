      "friends",
      "nobody"
    ]
  },
  "canChat": {
    "kind": "signature",
    "signature": "(first: PassClaims, second: PassClaims): boolean"
  },
  "checkChat": {
    "kind": "signature",
    "signature": "({ text, senderPass, receiverPasses }: ChatCheckOptions): Promise<ChatCheck>"
  },
  "defineGameServer": {
    "kind": "signature",
    "signature": "<S>(server: GameServer<S>): GameServer<S>"
  },
  "guestName": {
    "kind": "signature",
    "signature": "(): string"
  },
  "isRoomCode": {
    "kind": "signature",
    "signature": "(code: string): boolean"
  },
  "passesAreFriends": {
    "kind": "signature",
    "signature": "(first: PassClaims, second: PassClaims): boolean"
  },
  "passesHaveBlockBetween": {
    "kind": "signature",
    "signature": "(first: PassClaims, second: PassClaims): boolean"
  },
  "relay": {
    "kind": "constant",
    "value": "GameServer<{}>"
  },
  "verifyPass": {
    "kind": "signature",
    "signature": "(token: string, keys: Array<PublicKey>, expect: PassExpectations): Promise<PassClaims>"
  },
  "verifyReceipt": {
    "kind": "signature",
    "signature": "(token: string, keys: Array<PublicKey>, expect: ReceiptExpectations): Promise<ReceiptClaims>"
  },
  "verifyWebhook": {
    "kind": "signature",
    "signature": "(signingSecret: string, headers: WebhookHeaders, body: string, nowMs?: number): Promise<{ event: WebhookEvent; } | { error: WebhookError; }>"
  },
  "RunningServer": {
    "kind": "fields",
    "fields": {
      "close": ": () => Promise<void>",
      "httpServer": ": Server"
    }
  },
  "StartServerOptions": {
    "kind": "fields",
    "fields": {
      "gameServer": ": GameServer<any>",
      "gameSlug": ": string",
      "port": "?: number | undefined",
      "origins": "?: Array<string> | undefined",
      "issuerUrl": "?: string | undefined",
      "loadPassKeys": "?: ((isRefreshing?: boolean | undefined) => Promise<Array<PublicKey>>) | undefined",
      "loadReceiptKeys": "?: ((isRefreshing?: boolean | undefined) => Promise<Array<PublicKey>>) | undefined",
      "loadProfile": "?: ((playerId: string) => Promise<{ name: string; } | null>) | undefined",
      "database": "?: GameDatabase | undefined",
      "secrets": "?: Readonly<Record<string, string>> | undefined",
      "webhookSigningSecret": "?: string | undefined",
      "roomStateFile": "?: string | null | undefined",
      "zaismaKey": "?: string | undefined",
      "developerApiUrl": "?: string | undefined"
    }
  },
  "startServer": {
    "kind": "signature",
    "signature": "(options: StartServerOptions): RunningServer"
  }
}
