{
  "name": "zaisma",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:affected": "node scripts/affected-tests.mjs",
    "test:list": "node scripts/preview/background.mjs list",
    "typecheck": "tsc --noEmit",
    "dev:site": "npm run dev -w apps/site",
    "dev:games": "npm run dev -w apps/games",
    "db:migrate:local": "npm run db:migrate:local -w apps/site",
    "dev:rooms": "npm run dev -w apps/rooms",
    "preview": "node scripts/preview/run.mjs",
    "preview:start": "node scripts/preview/background.mjs start",
    "preview:stop": "node scripts/preview/background.mjs stop",
    "preview:list": "node scripts/preview/background.mjs list",
    "feedback": "node scripts/feedback.mjs",
    "ship": "node scripts/ship.mjs",
    "review-set": "node scripts/review-set/run.mjs",
    "listing-set": "node scripts/review-set/listing.mjs",
    "engines:play": "node scripts/engines/play.mjs",
    "design:catalog": "node scripts/design-catalog.mjs",
    "layout:check": "node scripts/layout-check.mjs",
    "components:minify": "node scripts/minify-components.mjs",
    "naming:baseline": "NAMING_WRITE_BASELINE=1 vitest run --project node test/node/naming.test.ts",
    "contracts:baseline": "CONTRACTS_WRITE_BASELINE=1 vitest run --project contracts"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/ws": "8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
