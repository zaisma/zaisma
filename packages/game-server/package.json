{
  "name": "@zaisma/game-server",
  "version": "1.12.0",
  "description": "Write a Zaisma game server once; run it in Zaisma rooms or on your own Node server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./bin/node.js",
    "./internal": "./src/internal.ts"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "peerDependencies": {
